      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "HILL HOUSE\u2019s exterior might be almost unchanged in the last
          hundred years, but the inside has not been so lucky. The memory of what
          must have once been splendour remains, but it is little more than a ghost
          now\u2013a faded recollection of a past that has been long forgotten by
          all who ever once bore witness to it. "
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1
      isRoot: 0
